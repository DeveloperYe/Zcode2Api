# ── Server ──
HOST=127.0.0.1
PORT=3101
# Incoming-request token. EMPTY = password-free, but then the server only
# starts while HOST is a loopback address (127.0.0.1 / localhost / ::1).
# Binding to 0.0.0.0 or a LAN IP without AUTH_TOKEN is refused at startup.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTH_TOKEN=
# Separate key for /v1/* and /async (empty = AUTH_TOKEN)
#GATEWAY_KEY=
# JWT file seeded into the pool at startup (one per line)
#ZCODE_KEYS=tokens.txt

# ── Proxies ──
# One-time seed of DB profiles on an empty database
PROXY_FILE=proxy.txt
# Egress rotations on a load verdict (3012/3007/3009/3010/529)
LOAD_SWAPS=4
# Accounts per client request (failover)
ACCOUNT_MAX_TRY=8
BILLING_WORKERS=25

# ── Brute-force guard (auth endpoints) ──
# Failed attempts per minute per IP (0 = off). Only rejected credentials count,
# so normal traffic is never throttled.
AUTH_RATE_LIMIT=5
# Consecutive failures that trigger a temporary lock (0 = off)
AUTH_LOCK_AFTER=20
AUTH_LOCK_MINUTES=15
# 1 = take the client IP from X-Forwarded-For / X-Real-IP (only behind a proxy
# you control — otherwise clients can spoof it and dodge the guard)
#TRUST_PROXY=1

# ── Captcha
CAPTCHA_SOLVE_TIMEOUT=40s
CAPTCHA_RETRIES=3
# Fully disable the background mint pool
#CAPTCHA_MODE=off
# Debugging only: disables TLS verification for the captcha solver's CDN
# downloads. The solver executes the downloaded JS, so OFF (verify) is the safe
# default; only set this when routing through mitmproxy/Charles/Fiddler.
#ZCODE_TLS_VERIFY=0

